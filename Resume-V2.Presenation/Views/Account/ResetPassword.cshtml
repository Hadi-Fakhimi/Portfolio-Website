@using Resume_V2.Application.DTOs
@model ResetPasswordViewModel
@{
	Layout = "_AccountLayout";
	ViewData["Title"] = "بازیابی کلمه عبور";
}

<div class="wrap-login100">
	<div class="login100-form-title" style="background-image: url(/Login/images/bg-01.jpg);">
		<span class="login100-form-title-1">
			بازیابی کلمه عبور
		</span>
	</div>

	<form asp-action="ResetPassword" method="post" class="login100-form validate-form">
		<input type="hidden" asp-for="Captcha" />
		<input type="hidden" asp-for="EmailActivationCode"/>

		<div class="wrap-input100 validate-input m-b-18" data-validate="Password is required">
			<span class="label-input100">کلمه عبور</span>
			<input asp-for="Password" class="input100" type="password" placeholder="کلمه عبور را وارد کنید">
			<span class="focus-input100"></span>
			<span class="text-danger" asp-validation-for="Password"></span>
		</div>

		<div class="wrap-input100 validate-input m-b-18" data-validate="Password is required">
			<span class="label-input100">تکرار کلمه عبور</span>
			<input asp-for="RePassword" class="input100" type="password" placeholder="تکرار کلمه عبور را وارد کنید">
			<span class="focus-input100"></span>
			<span class="text-danger" asp-validation-for="RePassword"></span>
		</div>

		<div class="container-login100-form-btn">
			<button type="submit" class="login100-form-btn">
				بازیابی
			</button>
		</div>
	</form>
</div>