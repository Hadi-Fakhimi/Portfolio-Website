@using Resume_V2.Application.DTOs
@model ForgotPasswordViewModel
@{
	Layout = "_AccountLayout";
	ViewData["Title"] = "فراموشی کلمه عبور";
}

<div class="wrap-login100">
	<div class="login100-form-title" style="background-image: url(/Login/images/bg-01.jpg);">
		<span class="login100-form-title-1">
			فراموشی کلمه عبور
		</span>
	</div>

	<form asp-action="ForgotPassword" method="post" class="login100-form validate-form">
		<input type="hidden" asp-for="Captcha" />
		<div class="wrap-input100 validate-input m-b-26" data-validate="Username is required">
			<span class="label-input100">ایمیل</span>
			<input asp-for="Email" class="input100" type="text" placeholder="ایمیل خود را وارد کنید">
			<span class="focus-input100"></span>
			<span class="text-danger" asp-validation-for="Email"></span>
		</div>

		<div class="container-login100-form-btn">
			<button type="submit" class="login100-form-btn">
				ارسال درخواست
			</button>
		</div>
	</form>
</div>