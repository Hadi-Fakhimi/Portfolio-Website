<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_PartialMetaTag" />
    <partial name="_PartialHeading" />
</head>
<body data-preloader="true">
    <!--  Toggle Menu -->
    <partial name="_PartialSideBar" />
    <!-- end Toggle Menu -->
    <!-- Main container -->
    <div class="container">
        <!-- Header -->
        <div id="header">
            <div class="row">
                <div class="col-12 col-lg-4 col-xl-3 order-lg-2 text-start">
                    <div class="d-inline-flex align-items-center">
                        <!-- Social Links -->
                        <partial name="_PartialSideBar" />
                        <!-- Toggle Menu Button -->
                        <button class="menu-dots">
                            <span></span>
                        </button>
                        <!-- end Toggle Menu Button -->
                    </div>
                </div>
                <!-- end col -->
                <div class="col-12 col-lg-8 order-lg-1 col-xl-9">
                    <div class="py-4">
                        <h1 class="display-2 fw-semi-bold m-0">
                            هادی <span class="text-shadow">فخیمی</span>
                        </h1>
                    </div>
                </div>
                <!-- end col -->
            </div>
            <!-- end row -->
        </div>
        <!-- end Header -->
        <!-- Main row -->
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4 col-xl-3">
                <!-- Sections Navigation -->
                <div class="nav-wrapper">
                    <div class="section-nav">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="nav-link-desktop">خانه</span>
                                    <span class="nav-link-mobile">خ</span>
                                    <span class="nav-circle"></span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link active">
                                    <span class="nav-link-desktop">نمونه کار</span>
                                    <span class="nav-link-mobile">ن</span>
                                    <span class="nav-circle"></span>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- end section-nav -->
                </div>
                <!-- end nav-wrapper -->
                <!-- end Sections Navigation -->
            </div>
            <!-- end col -->

            <div class="col-12 col-lg-8 col-xl-9">
                <div class="sections-wrapper">
                    <!-- Project content -->
                    @RenderBody()
                    <!-- end section-box -->
                    <!-- end Project Content -->
                </div>
            </div>
            <!-- end col -->
        </div>
        <!-- end main row -->
    </div>
    <!-- end main container -->
    <!-- Background Vertical lines -->
    <div class="bg-lines">
        <div class="bg-line-1"></div>
        <div class="bg-line-2"></div>
        <div class="bg-line-3"></div>
        <div class="bg-line-4"></div>
    </div>
    <!-- end Background Vertical lines -->
    <!-- JavaScripts -->
    <script>
        document.getElementById('darkModeToggle').addEventListener('click', function () {
            document.body.classList.toggle('theme-dark');
        });
    </script>
    <script src="/Site/assets/plugins/jquery.min.js"></script>
    <script src="/Site/assets/plugins/plugins.js"></script>
    <script src="/Site/assets/js/functions.js"></script>
</body>
</html>
