@using Resume_V2.Application.StaticTools
@model Resume_V2.Domain.Models.User
@{
    Layout = null;
}

<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ریست رمز عبور</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      color: #333333;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 20px auto;
      background-color: #ffffff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .logo {
      display: block;
      margin: 0 auto 20px;
      width: 100px;
      height: auto;
    }
    h1 {
      font-size: 24px;
      color: #333333;
      text-align: center;
    }
    p {
      font-size: 16px;
      line-height: 1.5;
      text-align: center;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      margin: 20px auto;
      background-color: #ff6699;
      color: #ffffff;
      text-decoration: none;
      font-size: 16px;
      border-radius: 5px;
      text-align: center;
    }
    .btn:hover {
      background-color: #ff3366;
    }
    .footer {
      font-size: 12px;
      color: #777777;
      text-align: center;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <div class="email-container">
    <h1>درخواست ریست رمز عبور</h1>
    <p>سلام @Model.FirstName @Model.LastName عزیز،</p>
    <p>شما درخواست ریست رمز عبور خود را داشتید. برای تغییر رمز عبور خود، روی دکمه زیر کلیک کنید:</p>
    <a href="@FilePaths.SiteAddress/Reset-Password/@Model.EmailActivationCode" class="btn">ریست رمز عبور</a>
    <p class="footer">اگر شما این درخواست را ارسال نکرده‌اید، لطفاً این ایمیل را نادیده بگیرید.</p>
  </div>

</body>
</html>
