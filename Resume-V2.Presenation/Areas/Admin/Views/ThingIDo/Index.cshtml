@using Resume_V2.Application.DTOs
@using Resume_V2.Application.StaticTools
@model List<ThingIDoViewModel>
@{
    ViewData["Title"] = "کار هایی که من انجام می دهم";
    Layout = "_AdminLayout";
}

<div class="col-md-12 my-4">
    <h2 class="h4 mb-1">لیست کار های من</h2>
    <button onclick="LoadThingIDoFormModal(0)" type="button" class="btn mb-2 btn-outline-success">افزودن</button>
    <div class="card shadow">
        <div class="card-body">
            <div class="toolbar">
                <form class="form">
                    <div class="form-row">
                        <div class="form-group col-auto mr-auto">
                            <label class="my-1 mr-2 sr-only" for="inlineFormCustomSelectPref1">Show</label>
                            <select class="custom-select mr-sm-2" id="inlineFormCustomSelectPref1">
                                <option value="" selected>...</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <!-- table -->
            <table class="table table-borderless table-hover">
                <thead>
                    <tr>
                        <th>آیکون</th>
                        <th>عنوان</th>
                        <th>اولویت</th>
                        <th>توضیحات</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>

                    @if(Model != null && Model.Any()){
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <p class="mb-0 text-muted"><strong>@item.Icon</strong></p>

                                </td>
                                <td>
                                    <p class="mb-0 text-muted"><strong>@item.Title</strong></p>

                                </td>
                                <td>
                                    <p class="mb-0 text-muted">@item.Order</p>

                                </td>
                                <td>
                                    <p class="mb-0 text-muted">@item.description</p>

                                </td>
                                <td>
                                    <button class="btn btn-sm dropdown-toggle more-horizontal" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <span class="text-muted sr-only">عملیات</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a class="dropdown-item" onclick="LoadThingIDoFormModal(@item.Id)">ویرایش</a>
                                        <a class="dropdown-item" onclick="DeleteThingIDo(@item.Id)">حذف</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
            <nav aria-label="Table Paging" class="mb-0 text-muted">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
