@using Resume_V2.Application.DTOs
@using Resume_V2.Application.StaticTools
@model AboutMeViewModel
@{
    ViewData["Title"] = "درباره من";
    Layout = "_AdminLayout";
}

<div class="col-md-12 my-4">
    <h2 class="h4 mb-1">لیست درباره ای من</h2>
    <button onclick="LoadAboutMeFormModal(0)" type="button" class="btn mb-2 btn-outline-success" data-toggle="modal" data-target="#verticalModal">افزودن</button>
    <div class="card shadow">
        <div class="card-body">
            <div class="toolbar">
                <form class="form">
                    <div class="form-row">
                        <div class="form-group col-auto mr-auto">
                            <label class="my-1 mr-2 sr-only" for="inlineFormCustomSelectPref1">Show</label>
                            <select class="custom-select mr-sm-2" id="inlineFormCustomSelectPref1">
                                <option value="" selected>...</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <!-- table -->
            <table class="table table-borderless table-hover">
                <thead>
                    <tr>
                        <th>آواتار</th>
                        <th>نام و نام خانوادگی</th>
                        <th>عنوان شاخه کاری</th>
                        <th>توضیحات</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>

                        <td>
                            <div class="avatar avatar-md">
                                <img src="@(string.IsNullOrEmpty(Model.AvatarImage) ? FilePaths.DefaultAvatar : $"{FilePaths.UserAvatarImg}{Model.AvatarImage}")" class="avatar-img rounded-circle">
                            </div>
                        </td>
                        <td>
                            <p class="mb-0 text-muted"><strong>@Model.Name</strong></p>
                            
                        </td>
                        <td>
                            <p class="mb-0 text-muted">@Model.Title</p>
                           
                        </td>
                        <td>
                            <p class="mb-0 text-muted">@Model.Description</p>
                            
                        </td>
                        <td>
                            <button class="btn btn-sm dropdown-toggle more-horizontal" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="text-muted sr-only">عملیات</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" onclick="LoadAboutMeFormModal(@Model.Id)">ویرایش</a>
                                <a class="dropdown-item" onclick="DeleteAboutMe(@Model.Id)">حذف</a>
                            </div>
                        </td>
                    </tr>


                </tbody>
            </table>
            <nav aria-label="Table Paging" class="mb-0 text-muted">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item active"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>